#!/usr/bin/env bash
set -e

cd /workspaces/yt

echo "================================"
echo "          GitHub Push"
echo "================================"
echo

echo "変更を確認しています..."
git status

if [[ -z "$(git status --porcelain)" ]]; then
    echo
    echo "変更がありません。"
    exit 0
fi

echo
echo "ファイルを追加しています..."
git add .

echo
read -rp "コミットメッセージ: " MESSAGE

if [[ -z "$MESSAGE" ]]; then
    MESSAGE="Update repository"
fi

echo
echo "コミットしています..."
git commit -m "$MESSAGE"

echo
echo "GitHubへPushしています..."
git push

echo
echo "================================"
echo "          Push 完了"
echo "================================"